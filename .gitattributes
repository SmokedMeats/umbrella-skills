# LF everywhere, including Windows clones with core.autocrlf=true.
* text=auto eol=lf
.githooks/* text eol=lf
scripts/check-public-safe.mjs text eol=lf
# Pinned upstream packs stay private; the public snapshot (git archive) leaves them out.
/vendor export-ignore
# Private policy installed with the umbrella skill folder. The public archive omits it.
/skills/umbrella/private-bindings.md export-ignore
# Operator-installed watcher. The public archive omits this directory.
/skills/umbrella/watcher export-ignore
/skills/umbrella/watcher/** export-ignore
# Decision-quote pins. The public archive omits them with the binding.
/scripts/check-binding-quote.test.mjs export-ignore
